{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "jsx": "preserve",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "lib": [
      "ESNext",
      "DOM"
    ],
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "vite/client",
      "ant-design-vue/typings/global"
    ]
  },
  "include": [
    "mobile/**/*.ts",
    "mobile/**/*.vue",
    "components/decoration/**/*",
    "hooks/decoration/useApplication*.ts",
    "hooks/decoration/useActionForm.ts",
    "hooks/decoration/useFiles.ts",
    "hooks/decoration/useSignature.ts",
    "services/decorationApi.ts",
    "types/decoration.ts",
    "utils/decoration.ts",
    "locales/lang/zh.json"
  ],
  "exclude": [
    "components/decoration/ConfigurationWorkspace.vue",
    "components/decoration/TaskWorkspace.vue",
    "components/decoration/AcceptanceWorkspace.vue",
    "components/decoration/OverviewDistribution.vue"
  ]
}
