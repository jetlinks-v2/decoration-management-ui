{
  "name": "decoration-management-ui",
  "id": "decoration-management",
  "version": "1.0.0",
  "private": true,
  "description": "装修管理 PC 与 APP H5",
  "main": "index.ts",
  "scripts": {
    "dev": "pnpm --filter jetlinks-web-core dev -- -- --module-name decoration-management-ui,property-base-ui,authentication-manager-ui",
    "build": "pnpm --filter jetlinks-web-core build -- -- --module-name decoration-management-ui",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "vue-tsc -p tsconfig.json --noEmit",
    "dev:mobile": "vite --config vite.mobile.config.ts",
    "typecheck:mobile": "vue-tsc --noEmit -p tsconfig.mobile.json",
    "build:mobile": "vite build --config vite.mobile.config.ts",
    "build:with-base": "pnpm --filter jetlinks-web-core build -- -- --module-name decoration-management-ui,property-base-ui"
  },
  "packageManager": "pnpm@9.9.0",
  "dependencies": {
    "html2canvas": "^1.4.1",
    "altcha": "3.2.2",
    "jsencrypt": "3.3.2"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "peerDependencies": {
    "vue": "^3.3.4",
    "vue-i18n": "^9.14.3",
    "ant-design-vue": "^4.2.6",
    "@ant-design/icons-vue": "^7.0.1",
    "dayjs": "^1.11.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "vite": "^7.1.5",
    "@vitejs/plugin-vue": "^6.0.1",
    "typescript": "^5.8.2",
    "vue-tsc": "^3.0.6",
    "esbuild": "^0.25.0"
  }
}
