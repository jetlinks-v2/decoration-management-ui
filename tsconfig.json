{
  "include": [
    "./**/*.ts",
    "./**/*.vue",
    "./**/*.json",
    "../../jetlinks-web-core/src/auto-imports.d.ts"
  ],
  "exclude": [
    "mobile",
    "dist-mobile",
    "vite.mobile.config.ts",
    "tests"
  ],
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "jsx": "preserve",
    "sourceMap": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "lib": [
      "ESNext",
      "DOM"
    ],
    "skipLibCheck": true,
    "noEmit": true,
    "allowJs": true,
    "types": [
      "ant-design-vue/typings/global",
      "vite/client"
    ],
    "baseUrl": ".",
    "paths": {
      "@jetlinks-web-core/*": [
        "../../jetlinks-web-core/src/*"
      ],
      "@decoration-management-ui/*": [
        "./*"
      ],
      "@property-base-ui/*": [
        "../property-base-ui/*"
      ]
    }
  }
}
